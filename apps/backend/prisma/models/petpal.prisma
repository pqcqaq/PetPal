model PetProfile {
  id               String     @id
  createId         String?
  updateId         String?
  ownerId          String
  name             String
  species          PetSpecies
  breed            String?
  gender           PetGender  @default(UNKNOWN)
  birthday         DateTime?
  weightKg         Decimal?   @db.Decimal(5, 2)
  neutered         Boolean    @default(false)
  temperamentTags  Json?
  feedingNote      String?
  allergyNote      String?
  medicalNote      String?
  emergencyContact Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deleteAt         DateTime?
  owner            User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requests         ServiceRequest[]

  @@index([ownerId])
  @@index([species])
  @@index([deleteAt])
}

model CaregiverProfile {
  id               String               @id
  createId         String?
  updateId         String?
  userId           String               @unique
  intro            String?
  experienceYears  Int                  @default(0)
  serviceRadiusKm  Int                  @default(5)
  serviceCity      String?
  specialtyTags    Json?
  serviceCommitment String?
  qualificationMaterials Json?
  ratingAvg        Decimal              @default(5.0) @db.Decimal(3, 2)
  ratingCount      Int                  @default(0)
  auditStatus      CaregiverAuditStatus @default(PENDING)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deleteAt         DateTime?
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  services         CaregiverService[]
  acceptedRequests ServiceRequest[]     @relation("MatchedCaregiver")
  orders           OrderMain[]
  serviceLogs      ServiceLog[]
  reviews          Review[]

  @@index([serviceCity])
  @@index([auditStatus])
  @@index([deleteAt])
}

model CaregiverService {
  id             String         @id
  createId       String?
  updateId       String?
  caregiverId    String
  serviceType    PetServiceType
  petSpecies     PetSpecies
  pricePerUnit   Decimal        @db.Decimal(10, 2)
  unitType       String
  minNoticeHours Int            @default(2)
  availableSlots Json
  serviceCity    String?
  serviceLat     Decimal?       @db.Decimal(9, 6)
  serviceLng     Decimal?       @db.Decimal(9, 6)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deleteAt       DateTime?
  caregiver      CaregiverProfile @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@index([caregiverId])
  @@index([serviceType, petSpecies])
  @@index([serviceCity])
  @@index([isActive])
  @@index([deleteAt])
}

model ServiceRequest {
  id                String               @id
  createId          String?
  updateId          String?
  ownerId           String
  petId             String
  serviceType       PetServiceType
  startTime         DateTime
  endTime           DateTime
  locationText      String
  locationLat       Decimal?             @db.Decimal(9, 6)
  locationLng       Decimal?             @db.Decimal(9, 6)
  budgetAmount      Decimal?             @db.Decimal(10, 2)
  demandTags        Json?
  status            ServiceRequestStatus @default(OPEN)
  matchedCaregiverId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deleteAt          DateTime?
  owner             User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pet               PetProfile           @relation(fields: [petId], references: [id], onDelete: Restrict)
  matchedCaregiver  CaregiverProfile?    @relation("MatchedCaregiver", fields: [matchedCaregiverId], references: [id], onDelete: SetNull)
  orders            OrderMain[]

  @@index([ownerId, status])
  @@index([petId])
  @@index([matchedCaregiverId])
  @@index([startTime, endTime])
  @@index([deleteAt])
}

model OrderMain {
  id               String         @id
  createId         String?
  updateId         String?
  orderNo          String         @unique
  ownerId          String
  caregiverId      String
  serviceRequestId String?
  serviceType      PetServiceType
  appointmentStart DateTime
  appointmentEnd   DateTime
  amountTotal      Decimal        @db.Decimal(10, 2)
  amountAdjusted   Decimal        @default(0) @db.Decimal(10, 2)
  amountPaid       Decimal        @default(0) @db.Decimal(10, 2)
  amountRefunded   Decimal        @default(0) @db.Decimal(10, 2)
  orderStatus      OrderStatus    @default(PENDING_ACCEPT)
  cancelReason     String?
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deleteAt         DateTime?
  owner            User           @relation("OrderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  caregiver        CaregiverProfile @relation(fields: [caregiverId], references: [id], onDelete: Restrict)
  serviceRequest   ServiceRequest?  @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  payments         PaymentRecord[]
  refunds          RefundRecord[]
  conversation     OrderConversation?
  timelines        OrderTimeline[]
  serviceLogs      ServiceLog[]
  review           Review?
  complaints       Complaint[]
  penalties        PenaltyRecord[]

  @@index([ownerId, orderStatus])
  @@index([caregiverId, orderStatus])
  @@index([serviceRequestId])
  @@index([appointmentStart, appointmentEnd])
  @@index([deleteAt])
}

model OrderConversation {
  id                   String      @id
  createId             String?
  updateId             String?
  orderId              String      @unique
  ownerUnreadCount     Int         @default(0)
  caregiverUnreadCount Int         @default(0)
  lastMessageAt        DateTime?
  lastMessagePreview   String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deleteAt             DateTime?
  order                OrderMain   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages             OrderMessage[]

  @@index([lastMessageAt])
  @@index([deleteAt])
}

model OrderMessage {
  id             String            @id
  createId       String?
  updateId       String?
  conversationId String
  senderRole     OrderOperatorRole
  senderUserId   String
  content        String?
  mediaUrls      Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deleteAt       DateTime?
  conversation   OrderConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
  @@index([senderRole, createdAt])
  @@index([deleteAt])
}

model OrderTimeline {
  id           String                 @id
  createId     String?
  updateId     String?
  orderId      String
  eventType    OrderTimelineEventType
  operatorRole OrderOperatorRole
  operatorId   String?
  eventPayload Json?
  createdAt    DateTime               @default(now())
  deleteAt     DateTime?
  order        OrderMain              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([eventType, createdAt])
  @@index([deleteAt])
}

model ServiceLog {
  id         String         @id
  createId   String?
  updateId   String?
  orderId     String
  caregiverId String
  logType    ServiceLogType
  textNote   String?
  mediaUrls  Json?
  geo        Json?
  happenedAt DateTime
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deleteAt   DateTime?
  order      OrderMain      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  caregiver  CaregiverProfile @relation(fields: [caregiverId], references: [id], onDelete: Restrict)

  @@index([orderId, happenedAt])
  @@index([caregiverId, happenedAt])
  @@index([logType])
  @@index([deleteAt])
}

model Review {
  id          String           @id
  createId    String?
  updateId    String?
  orderId      String          @unique
  ownerId      String
  caregiverId  String
  rating      Int
  tags        Json?
  content     String?
  isAnonymous Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deleteAt    DateTime?
  order       OrderMain       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  owner       User            @relation("PetPalReviewOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  caregiver   CaregiverProfile @relation(fields: [caregiverId], references: [id], onDelete: Restrict)

  @@index([ownerId, createdAt])
  @@index([caregiverId, createdAt])
  @@index([rating])
  @@index([deleteAt])
}

model Complaint {
  id            String              @id
  createId      String?
  updateId      String?
  orderId       String
  complainantId String
  assignedAdminId String?
  targetRole    ComplaintTargetRole
  complaintType ComplaintType
  description   String
  evidenceUrls  Json?
  status        ComplaintStatus     @default(OPEN)
  resultSummary String?
  closedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deleteAt      DateTime?
  order         OrderMain           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  complainant   User                @relation("PetPalComplaintComplainant", fields: [complainantId], references: [id], onDelete: Cascade)
  assignedAdmin User?               @relation("PetPalComplaintAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  processLogs   ComplaintProcessLog[]
  penalties     PenaltyRecord[]

  @@index([orderId, createdAt])
  @@index([complainantId, status])
  @@index([assignedAdminId, status])
  @@index([status, createdAt])
  @@index([targetRole, createdAt])
  @@index([complaintType, createdAt])
  @@index([deleteAt])
}

model ComplaintProcessLog {
  id          String              @id
  createId    String?
  updateId    String?
  complaintId String
  actionType  ComplaintActionType
  operatorId  String?
  note        String?
  createdAt   DateTime            @default(now())
  deleteAt    DateTime?
  complaint   Complaint           @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  operator    User?               @relation("PetPalComplaintOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([complaintId, createdAt])
  @@index([operatorId, createdAt])
  @@index([actionType, createdAt])
  @@index([deleteAt])
}

model PenaltyRecord {
  id            String               @id
  createId      String?
  updateId      String?
  complaintId   String
  orderId       String
  targetRole    ComplaintTargetRole
  targetUserId  String?
  penaltyType   PenaltyType
  severity      PenaltySeverity
  reason        String
  actionSummary String
  rectifyStatus PenaltyRectifyStatus @default(PENDING)
  rectifyDueAt  DateTime?
  rectifiedAt   DateTime?
  rectifyNote   String?
  rectifyEvidenceUrls Json?
  rectifyEvidenceMaterials Json?
  rectifyReviewStatus PenaltyRectifyReviewStatus @default(NOT_REQUIRED)
  rectifyReviewNote String?
  rectifyReviewedAt DateTime?
  rectifyReviewedById String?
  appealStatus  PenaltyAppealStatus  @default(NONE)
  appealReason  String?
  appealSubmittedAt DateTime?
  appealSubmittedById String?
  appealReviewedAt DateTime?
  appealReviewedById String?
  appealReviewNote String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deleteAt      DateTime?
  complaint     Complaint            @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  order         OrderMain            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  targetUser    User?                @relation("PetPalPenaltyTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  creator       User?                @relation("PetPalPenaltyCreator", fields: [createId], references: [id], onDelete: SetNull)
  updater       User?                @relation("PetPalPenaltyUpdater", fields: [updateId], references: [id], onDelete: SetNull)
  rectifyReviewer User?              @relation("PetPalPenaltyRectifyReviewer", fields: [rectifyReviewedById], references: [id], onDelete: SetNull)
  appealSubmitter User?              @relation("PetPalPenaltyAppealSubmitter", fields: [appealSubmittedById], references: [id], onDelete: SetNull)
  appealReviewer User?               @relation("PetPalPenaltyAppealReviewer", fields: [appealReviewedById], references: [id], onDelete: SetNull)

  @@index([complaintId, createdAt])
  @@index([orderId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetRole, createdAt])
  @@index([penaltyType, severity])
  @@index([rectifyStatus, rectifyDueAt])
  @@index([rectifyReviewStatus, updatedAt])
  @@index([rectifyReviewedById])
  @@index([appealStatus, appealSubmittedAt])
  @@index([appealSubmittedById])
  @@index([appealReviewedById])
  @@index([deleteAt])
}

model PenaltyTemplate {
  id                String               @id
  createId          String?
  updateId          String?
  templateCode      String               @unique
  templateName      String
  description       String?
  targetRole        ComplaintTargetRole?
  penaltyType       PenaltyType
  severity          PenaltySeverity
  defaultReason     String
  actionSummary     String
  defaultRectifyDays Int?
  isActive          Boolean              @default(true)
  usageCount        Int                  @default(0)
  lastUsedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deleteAt          DateTime?
  creator           User?                @relation("PetPalPenaltyTemplateCreator", fields: [createId], references: [id], onDelete: SetNull)
  updater           User?                @relation("PetPalPenaltyTemplateUpdater", fields: [updateId], references: [id], onDelete: SetNull)

  @@index([targetRole, isActive])
  @@index([penaltyType, severity])
  @@index([isActive, updatedAt])
  @@index([lastUsedAt])
  @@index([deleteAt])
}

model PlatformRule {
  id          String             @id
  createId    String?
  updateId    String?
  ruleCode    String
  ruleName    String
  ruleVersion String
  contentMd   String
  effectiveAt DateTime
  status      PlatformRuleStatus @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deleteAt    DateTime?
  creator     User?              @relation("PetPalPlatformRuleCreator", fields: [createId], references: [id], onDelete: SetNull)
  updater     User?              @relation("PetPalPlatformRuleUpdater", fields: [updateId], references: [id], onDelete: SetNull)

  @@unique([ruleCode, ruleVersion])
  @@index([ruleCode])
  @@index([status, effectiveAt])
  @@index([deleteAt])
}

model PaymentRecord {
  id             String       @id
  createId       String?
  updateId       String?
  orderId        String
  payNo          String       @unique
  bizType        PaymentBizType
  payChannel     String
  payStatus      PaymentStatus @default(PENDING)
  payAmount      Decimal      @db.Decimal(10, 2)
  channelTxnId   String?      @unique
  paidAt         DateTime?
  channelPayload Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deleteAt       DateTime?
  order          OrderMain    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds        RefundRecord[]
  callbackAudits CallbackAudit[]

  @@index([orderId, payStatus])
  @@index([deleteAt])
}

model RefundRecord {
  id              String       @id
  createId        String?
  updateId        String?
  orderId         String
  paymentId       String?
  refundNo        String       @unique
  applyUserId     String
  refundType      RefundType
  refundReason    String
  refundAmount    Decimal      @db.Decimal(10, 2)
  refundStatus    RefundStatus @default(PENDING)
  channelRefundId String?      @unique
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deleteAt        DateTime?
  order           OrderMain    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment         PaymentRecord? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  applyUser       User         @relation("RefundApplyUser", fields: [applyUserId], references: [id], onDelete: Restrict)
  reviewer        User?        @relation("RefundReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  callbackAudits  CallbackAudit[]

  @@index([orderId, refundStatus])
  @@index([paymentId])
  @@index([applyUserId])
  @@index([deleteAt])
}

model CallbackAudit {
  id                  String @id
  createId            String?
  updateId            String?
  callbackType        String @default("PAYMENT_CALLBACK") // PAYMENT_CALLBACK | REFUND_CALLBACK
  paymentId           String?
  refundId            String?
  requestId           String @unique
  sourceMode          String @default("UNKNOWN") // TOKEN | WECHATPAY_HMAC | WECHATPAY_SDK
  signatureDigest     String?
  callbackTimestamp   String?
  callbackStatus      String @default("PENDING") // PENDING | SUCCESS | FAILURE | ERROR
  verificationResult  String? // JSON string of verification details
  rawPayload          String? // Original callback body
  processedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  payment             PaymentRecord? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refund              RefundRecord? @relation(fields: [refundId], references: [id], onDelete: SetNull)
  alertOutboxes       CallbackAlertOutbox[]

  @@index([requestId])
  @@index([callbackType, callbackStatus])
  @@index([paymentId])
  @@index([refundId])
  @@index([createdAt])
  @@index([sourceMode])
}

model CallbackAlertOutbox {
  id              String @id
  createId        String?
  updateId        String?
  callbackAuditId String
  eventType       String @default("CALLBACK_FAILURE_ALERT")
  status          String @default("PENDING") // PENDING | PROCESSING | SENT | FAILED | DEAD
  retryCount      Int @default(0)
  maxRetries      Int @default(5)
  nextRetryAt     DateTime @default(now())
  lastError       String?
  payload         Json
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  callbackAudit   CallbackAudit @relation(fields: [callbackAuditId], references: [id], onDelete: Cascade)
  replayLogs      CallbackAlertReplayLog[]

  @@index([callbackAuditId])
  @@index([status, nextRetryAt])
  @@index([createdAt])
}

model CallbackAlertReplayLog {
  id              String @id
  createId        String?
  updateId        String?
  callbackOutboxId String
  actionType      String @default("REQUEUE") // REQUEUE | REQUEUE_DEAD_BATCH
  actorId         String?
  note            String?
  createdAt       DateTime @default(now())
  outbox          CallbackAlertOutbox @relation(fields: [callbackOutboxId], references: [id], onDelete: Cascade)

  @@index([callbackOutboxId, createdAt])
  @@index([actorId])
}
